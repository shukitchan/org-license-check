  "_patterns_comment": "Ordered regex fallbacks over the normalized license string, applied only when no alias or exact name matched. First match wins, so narrower families must come first.",
  "patterns": [
    { "match": "^AGPL", "license": "AGPL" },
    { "match": "^LGPL", "license": "LGPL" },
    { "match": "^GPL", "license": "GPL" },
    { "match": "^(MPL|MOZILLA)", "license": "Mozilla 2.0" },
    { "match": "^(EPL|ECLIPSE)", "license": "Eclipse 2.0" },
    { "match": "^EUPL", "license": "European 1.2" },
    { "match": "^OSL", "license": "Open Software 3.0" },
    { "match": "^CECILL", "license": "CeCILL" },
    { "match": "^LPPL", "license": "LaTeX 1.3c" },
    { "match": "^(APACHE|ASL)", "license": "Apache 2.0" },
    { "match": "^MIT", "license": "MIT" },
    { "match": "^BSD", "license": "BSD" }
  ]
